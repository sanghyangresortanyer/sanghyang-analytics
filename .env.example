# ==============================================================================
# Sanghyang Analytics — Template Variabel Lingkungan (ADR-014)
# ==============================================================================
# Salin kunci yang diperlukan ke `.env.development.local` (pengembangan lokal)
# atau `.env.local` / Vercel Environment Variables (produksi baru).
# Jangan pernah menyimpan nilai rahasia asli di berkas ini.

# --- 1. URL Aplikasi & Supabase Proyek Baru (Auth, RLS, Storage, PostgREST, 1 Schema public) ---
# Produksi: "https://sanghyang-analytics.vercel.app" · Pengembangan lokal (.env.development.local): "http://127.0.0.1:3001"
NEXT_PUBLIC_APP_URL="https://sanghyang-analytics.vercel.app"
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Kunci rahasia server-only (JANGAN pernah diawali NEXT_PUBLIC_ atau diimpor di komponen klien).
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="source-files"

# --- 2. PostgreSQL / Prisma (Lokal 127.0.0.1:55432 atau Pooler Supabase Baru, Schema public) ---
DATABASE_URL="postgresql://sanghyang_local:password@127.0.0.1:55432/sanghyang_analytics?schema=public"
DIRECT_URL="postgresql://sanghyang_local:password@127.0.0.1:55432/sanghyang_analytics?schema=public"

# --- 3. Pengaman Tulis Basis Data Produksi ---
# Penanda host/ref DB produksi Supabase baru (mis. "pooler.supabase.com" atau "<project-ref>") agar skrip lokal menolak tulis tak sengaja.
PRODUCTION_DATABASE_MARKER="pooler.supabase.com"
ALLOW_PRODUCTION_WRITE="0"

# --- 4. Identitas Properti & Cron Tunggal ---
# UUID baris `public.properties` Sanghyang pada proyek Supabase baru.
MARKETING_PROPERTY_ID=""
SHEETS_PROPERTY_ID=""
# Rahasia Bearer bersama untuk `/api/cron/sync-sheets` dan `/api/cron/scrape`.
CRON_SECRET=""

# --- 5. GitHub & Otomasi Workflow Dispatch ---
# Token lokal proyek untuk MCP GitHub (scripts/mcp/github-mcp-server.sh).
GITHUB_ACCESS_TOKEN=""
# Fine-grained PAT terbatas (Actions: Read & Write) untuk pemicu pembaruan dari Vercel UI.
GITHUB_DISPATCH_TOKEN=""
GITHUB_REPO="sanghyangresortanyer/sanghyang-analytics"
GITHUB_DISPATCH_REF="main"

# --- 6. Google Ads & Google Analytics 4 (GA4) ---
# Untuk Vercel/serverless: isi JSON utuh OAuth desktop client satu baris.
GOOGLE_OAUTH_CLIENT_JSON=""
# Untuk pengembangan lokal: path berkas lokal (diabaikan git, mis. config/marketing/google-oauth-client.json).
GA4_CREDENTIALS_FILE=""
GA4_PROPERTY_ID=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""
# Opsional bila akun Google Ads memakai developer token / MCC login customer terpisah.
# GOOGLE_ADS_DEVELOPER_TOKEN=""
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# --- 7. Meta & Instagram Resmi ---
META_ACCESS_TOKEN=""
META_APP_ID=""
META_BUSINESS_ID=""
# Opsional jalur Business Discovery Graph API (kosong = gunakan Ekstensi Chrome Sanghyang Analytics Sync).
INSTAGRAM_GRAPH_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""
INSTAGRAM_GRAPH_API_VERSION=""

# --- 8. Sinkronisasi Google Sheets (Inventory HK & DML Pembelian Outlet) ---
GOOGLE_SHEET_HK_ID=""
GOOGLE_SHEET_DML_ID=""
# Opsional: batas tanggal awal lembar DML (YYYY-MM-DD).
DML_MIN_LIST_DATE=""

# --- 9. Booking Engine Resmi Sanghyang (Exely Search API) ---
EXELY_API_BASE_URL=""
EXELY_CLIENT_ID=""
EXELY_CLIENT_SECRET=""
EXELY_PROPERTY_ID=""

# --- 10. AI Analitik (Google Gemini — tidak pernah disebut di UI/PDF) ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# --- 11. Notifikasi Briefing Pagi (Opsional Telegram / Webhook) ---
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""
# ALERT_WEBHOOK_URL=""

# --- 12. Perayap, Crawl4AI, & Sumber Publik Opsional ---
# Linux Ubuntu 23.10+ dengan AppArmor: set 1 agar Chrome lokal dapat mencetak PDF.
PUPPETEER_NO_SANDBOX=""
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/google-chrome"
# CRAWL4AI_URL="http://127.0.0.1:8000"
# CRAWL4AI_API_TOKEN=""
# CRAWLER_HOST="0.0.0.0"
# CRAWLER_PORT="8000"
# CRAWLER_CONCURRENCY="2"
# CRAWLER_TIMEOUT_MS="45000"
# CRAWLER_MIN_TEXT_CHARS="120"
# CRAWLER_MIN_IMAGE_WIDTH="400"
# Kunci gratis BPS WebAPI (https://webapi.bps.go.id/developer/) untuk rilis TPK hotel bintang Banten.
BPS_WEBAPI_KEY=""
# Opsional integrasi Google Places / Google Business Profile.
# GOOGLE_PLACES_API_KEY=""
# GOOGLE_BUSINESS_PROFILE_API_KEY=""
# GOOGLE_BUSINESS_ACCOUNT_ID=""

# --- 13. Ambang Dinamis & Pengaturan Pembaruan (Zero Hardcode Overrides) ---
# SCORE_TINGGI="8"
# SCORE_SEDANG="3"
# DUPE_THRESHOLD="0.45"
# DYNAMIC_REFRESH_STALE_DAYS="7"
# DYNAMIC_REFRESH_FORCE="0"
# DYNAMIC_REFRESH_SKIP="0"
# DYNAMIC_REFRESH_MAX_CALLS="12"
# REFRESH_14NIGHT_RATES="0"
# REFRESH_SKIP_HOLISTIC="0"

# --- 14. Jembatan Login Pengembangan Lokal (Opsional untuk uji visual lokal; nonaktif di produksi) ---
# Hanya aktif bila NODE_ENV=development dan ketiganya terisi. Jangan pernah diisi di Vercel/produksi.
# LOCAL_DEV_AUTH_USER=""
# LOCAL_DEV_AUTH_EMAIL=""
# LOCAL_DEV_AUTH_PASSWORD=""
