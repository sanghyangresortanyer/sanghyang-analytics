{
  "manifest_version": 3,
  "name": "Sanghyang Analytics Sync",
  "version": "1.2.0",
  "description": "Sinkronisasi data media sosial Instagram dan TikTok langsung dari sesi peramban tim marketing ke dashboard Sanghyang Analytics.",
  "key": "",
  "permissions": ["scripting", "storage", "unlimitedStorage"],
  "host_permissions": [
    "https://analytics.sanghyang.com/*",
    "https://sanghyang-analytics.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "https://m.instagram.com/*",
    "https://www.tiktok.com/*",
    "https://tiktok.com/*",
    "https://m.tiktok.com/*",
    "https://vm.tiktok.com/*",
    "https://vt.tiktok.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*",
        "https://m.instagram.com/*",
        "https://www.tiktok.com/*",
        "https://tiktok.com/*",
        "https://m.tiktok.com/*",
        "https://vm.tiktok.com/*",
        "https://vt.tiktok.com/*"
      ],
      "js": ["feed-tap.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*",
        "https://m.instagram.com/*",
        "https://www.tiktok.com/*",
        "https://tiktok.com/*",
        "https://m.tiktok.com/*",
        "https://vm.tiktok.com/*",
        "https://vt.tiktok.com/*"
      ],
      "js": ["feed-parsers.js", "parsers.js", "content-social.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://analytics.sanghyang.com/*",
      "https://sanghyang-analytics.vercel.app/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sanghyang Analytics Sync",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
