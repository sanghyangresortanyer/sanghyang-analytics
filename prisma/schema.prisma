generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SourceCategory {
  news
  fnb
  event
  competitor
  review
}

enum ScrapeMethod {
  rss
  http
  browser
  manual
}

enum ArticleStatus {
  discovered
  extracted
  failed
  duplicate
}

enum MarketItemKind {
  fnb
  event
  entertainment
  destination
}

enum ScrapeJob {
  news
  rates
  reviews
  social
  promos
  website
  ratings
  photos
  room_rates
}

enum ScrapeRunStatus {
  running
  success
  partial
  failed
}

enum ScrapeStage {
  fetch
  parse
  extract
  persist
}

enum PromotionStatus {
  new
  changed
  expired
}

enum MarketInsightType {
  insight
  opportunity
  recommendation
}

enum MarketInsightStatus {
  active
  archived
}

model Source {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  domain          String
  category        SourceCategory
  method          ScrapeMethod
  enabled         Boolean        @default(true)
  priority        Int            @default(0)
  intervalMinutes Int?
  lastRunAt       DateTime?
  lastSuccessAt   DateTime?
  failureCount    Int            @default(0)
  version         Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  articles        Article[]
  scrapeRuns      ScrapeRun[]
  scrapeErrors    ScrapeError[]

  @@unique([domain, method])
  @@index([category, enabled])
  @@index([enabled, priority])
}

model Article {
  id              String        @id @default(uuid()) @db.Uuid
  sourceId        String        @db.Uuid
  title           String
  canonicalUrl    String?       @unique
  normalizedTitle String
  publishedAt     DateTime?
  description     String?
  content         String?
  imageUrl        String?
  /// Origin situs penerbit dari elemen <source url> RSS Google News; dipakai untuk mencari artikel di situs penerbit.
  publisherUrl    String?
  contentHash     String?       @unique
  status          ArticleStatus @default(discovered)
  version         Int           @default(1)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  source          Source        @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  marketItem      MarketItem?

  @@index([sourceId, normalizedTitle, publishedAt])
  @@index([sourceId, contentHash])
  @@index([status, createdAt])
}

model MarketItem {
  id        String         @id @default(uuid()) @db.Uuid
  articleId String         @unique @db.Uuid
  kind      MarketItemKind
  location  String?
  venue     String?
  organizer String?
  brand     String?
  description    String?
  targetAudience String?
  relevanceScore Int?
  startsAt  DateTime?
  endsAt    DateTime?
  tags      Json?
  /// Hasil pembacaan isi artikel (lib/market/news-relevance.ts). NULL berarti belum dibaca.
  readStatus  NewsReadStatus?
  readAt      DateTime?
  /// Kaitan dengan outlet atau sebab tidak terbaca/tidak relevan, dalam Bahasa Indonesia.
  readNote    String?
  readSummary String?
  /// Outlet Sanghyang yang terkait menurut pembacaan isi artikel.
  outlets     String[]       @default([])
  /// Alamat artikel di situs penerbit tempat isinya dibaca.
  articleUrl  String?
  /// Jarak garis lurus lokasi berita ke Sanghyang; 0 bila wilayah administratifnya memuat Sanghyang.
  distanceKm  Float?
  version   Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  article   Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([kind, location])
  @@index([startsAt])
  @@index([readStatus])
}

/// Hasil pembacaan isi berita: relevan untuk outlet dan lokasinya dalam radius, atau sebab berita tidak ditampilkan.
enum NewsReadStatus {
  relevan
  tidak_relevan
  di_luar_radius
  lokasi_tidak_jelas
  tidak_terbaca
}

/// Koordinat tempat dari pencarian Google Maps untuk lokasi berita; satu baris per teks pencarian supaya tidak dicari ulang.
model GeoPlace {
  id         String   @id @default(uuid()) @db.Uuid
  query      String   @unique
  name       String?
  lat        Float?
  lng        Float?
  mapsUrl    String?
  /// Sebab koordinat kosong (tidak ditemukan), supaya pencarian yang sama tidak diulang tiap malam.
  note       String?
  version    Int      @default(1)
  observedAt DateTime @default(now())
}

model Competitor {
  id               String                    @id @default(uuid()) @db.Uuid
  name             String
  category         String?
  group            String?
  outlets          String[]                  @default([])
  placeId          String?
  googleMapsUrl    String?
  mapsUrl          String?
  roadKm           Float?
  driveMinutes     Int?
  straightKm       Float?
  distanceSource   String?
  address          String?
  starRating       Int?
  roomCount        Int?
  websiteUrl       String?
  instagramUrl     String?
  facebookUrl      String?
  tiktokUrl        String?
  location         String?
  rating           Decimal?                  @db.Decimal(3, 2)
  reviewCount      Int?
  ratingSource     String?
  ratingSourceUrl  String?
  ratingObservedAt DateTime?
  bookingUrl       String?
  ratesUrl         String?
  socialUrl        String?
  active           Boolean                   @default(true)
  /// Peran dalam pembanding outlet: "inti" dihitung dalam pangsa pasar, "benchmark" hanya ditampilkan sebagai acuan.
  /// Null untuk properti sendiri dan entri yang belum dinilai. Aturan kelayakan ada di lib/market/compset.ts.
  compsetRole      String?
  /// Hotel induk untuk restoran, bar, atau spa yang berada di dalam hotel; null untuk tempat yang berdiri sendiri.
  parentId         String?                   @db.Uuid
  parent           Competitor?               @relation("CompetitorParent", fields: [parentId], references: [id], onDelete: Restrict)
  venues           Competitor[]              @relation("CompetitorParent")
  retiredReason    String?
  verifiedAt       DateTime?
  notes            String?
  version          Int                       @default(1)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  priceSnapshots   CompetitorPriceSnapshot[]
  promotions       CompetitorPromotion[]
  reviews          CompetitorReview[]
  facts            CompetitorFact[]

  @@index([active, name])
  @@index([active, category])
  @@index([active, compsetRole])
  @@index([placeId])
  @@index([parentId])
}

model CompetitorPriceSnapshot {
  id            String     @id @default(uuid()) @db.Uuid
  competitorId  String     @db.Uuid
  roomName      String?
  packageName   String?
  price         Decimal    @db.Decimal(12, 2)
  originalPrice Decimal?   @db.Decimal(12, 2)
  discount      Decimal?   @db.Decimal(5, 2)
  currency      String     @default("IDR")
  guests        Int        @default(2)
  checkIn       DateTime?
  checkOut      DateTime?
  source        String
  sourceUrl     String?
  observedAt    DateTime   @default(now())
  version       Int        @default(1)
  createdAt     DateTime   @default(now())
  competitor    Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, observedAt])
  @@index([source, observedAt])
}

model SanghyangPriceSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  roomName      String
  packageName   String?
  price         Decimal  @db.Decimal(12, 2)
  originalPrice Decimal? @db.Decimal(12, 2)
  discount      Decimal? @db.Decimal(5, 2)
  currency      String   @default("IDR")
  guests        Int      @default(2)
  checkIn       DateTime
  checkOut      DateTime
  source        String
  sourceUrl     String?
  observedAt    DateTime @default(now())
  version       Int      @default(1)
  createdAt     DateTime @default(now())

  @@index([roomName, checkIn, checkOut, guests])
  @@index([observedAt])
}

model CompetitorPromotion {
  id            String          @id @default(uuid()) @db.Uuid
  competitorId  String          @db.Uuid
  title         String
  category      String
  description   String?
  startsAt      DateTime
  endsAt        DateTime?
  price         Decimal?        @db.Decimal(12, 2)
  originalPrice Decimal?        @db.Decimal(12, 2)
  discount      Decimal?        @db.Decimal(5, 2)
  source        String
  sourceUrl     String?
  imageUrl      String?
  capturedAt    DateTime
  status        PromotionStatus
  /// Promo atau event menurut pembacaan AI; null bila baris belum dibaca (langkah situs pada penyegaran mengisinya).
  kind          PromotionKind?
  /// Isi paket atau rangkaian acara, disalin persis dari sumber (butir yang tidak ada di teks sumber dibuang).
  details       String[]        @default([])
  /// Syarat dan masa berlaku, disalin persis dari sumber.
  terms         String[]        @default([])
  /// Kategori promosi (lib/market/promo-type.ts) menurut pembacaan AI; null bila belum dibaca atau baris berupa event.
  promotionType PromotionType?
  version       Int             @default(1)
  createdAt     DateTime        @default(now())
  competitor    Competitor      @relation(fields: [competitorId], references: [id], onDelete: Restrict)

  @@index([competitorId, capturedAt])
  @@index([status, startsAt, endsAt])
  @@index([kind])
}

enum PromotionKind {
  promo
  event
}

enum PromotionType {
  kerja_sama_mitra
  program_member
  kontes_hadiah
  potongan_harga
  bonus_tambahan
  paket_bundling
  harga_spesial
  produk_baru
  brand_awareness
}

enum ReviewSentiment {
  positive
  neutral
  negative
}

model CompetitorReview {
  id           String          @id @default(uuid()) @db.Uuid
  competitorId String          @db.Uuid
  externalId   String
  source       String
  sourceUrl    String
  rating       Decimal         @db.Decimal(3, 2)
  reviewDate   DateTime
  title        String?
  text         String
  sentiment    ReviewSentiment
  themes       String[]
  capturedAt   DateTime
  /// Diisi untuk data riset lama yang terbukti ditulis manual; baris arsip tidak ditampilkan.
  archivedAt   DateTime?
  version      Int             @default(1)
  createdAt    DateTime        @default(now())
  competitor   Competitor      @relation(fields: [competitorId], references: [id], onDelete: Restrict)

  @@unique([competitorId, source, externalId])
  @@index([competitorId, reviewDate])
  @@index([sentiment, reviewDate])
}

/// Fakta profil tempat dari halaman resminya (operator, tipe kamar, fasilitas, lokasi), satu fakta satu sumber.
/// `value` berisi {"text": ..., "quote": ...}; kutipan harus ada di teks halaman sumber saat dikumpulkan.
model CompetitorFact {
  id           String     @id @default(uuid()) @db.Uuid
  competitorId String     @db.Uuid
  /// profil | kamar | lokasi | fasilitas | segmen
  section      String
  key          String
  value        Json
  sourceUrl    String
  observedAt   DateTime
  verifiedAt   DateTime?
  version      Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Restrict)

  @@unique([competitorId, section, key])
  @@index([competitorId, section])
}

/// Statistik makro pasar dari sumber resmi (mis. TPK hotel bintang Banten dari BPS), satu baris per indikator per bulan.
model MarketMacroStat {
  id          String   @id @default(uuid()) @db.Uuid
  /// Kunci indikator, mis. "tpk_hotel_bintang_banten".
  key         String
  /// Hari pertama bulan data.
  period      DateTime @db.Date
  value       Decimal  @db.Decimal(10, 4)
  unit        String
  sourceTitle String
  sourceUrl   String
  observedAt  DateTime @default(now())
  version     Int      @default(1)
  createdAt   DateTime @default(now())

  @@unique([key, period])
  @@index([key, period])
}

/// Omset riil per outlet per bulan, hasil impor laporan pembukuan. Hanya dibaca lewat API yang wajib login.
model OutletMonthlyRevenue {
  id         String   @id @default(uuid()) @db.Uuid
  outletKey  String
  /// Hari pertama bulan laporan.
  month      DateTime @db.Date
  revenue    Decimal  @db.Decimal(14, 2)
  sourceFile String
  importedAt DateTime @default(now())
  version    Int      @default(1)

  @@unique([outletKey, month])
}

/// Potret bulanan per outlet untuk perbandingan "vs bulan lalu": job malam meng-upsert bulan berjalan.
/// Sentimen & promo dihitung dari data bertanggal, jadi yang dipotret hanya yang tidak punya riwayat.
model OutletMonthlySnapshot {
  id                    String   @id @default(uuid()) @db.Uuid
  outletKey             String
  /// Hari pertama bulan.
  month                 DateTime @db.Date
  /// Rating Google Maps outlet saat dipotret; null bila listing tidak terbaca.
  googleRating          Decimal? @db.Decimal(3, 2)
  pricePositioningIndex Decimal? @db.Decimal(6, 1)
  reviewsRecorded       Int
  capturedAt            DateTime @default(now())
  version               Int      @default(1)

  @@unique([outletKey, month])
}

/// Tujuan bulanan per outlet, diisi tim digital marketing dan dievaluasi di akhir bulan.
model MarketingGoal {
  id                     String    @id @default(uuid()) @db.Uuid
  outletKey              String
  /// Hari pertama bulan.
  month                  DateTime  @db.Date
  /// Target kenaikan omset dibanding bulan lalu, dalam persen (omset rupiah tidak disimpan di sini).
  targetRevenueGrowthPct Decimal?  @db.Decimal(6, 2)
  targetRating           Decimal?  @db.Decimal(3, 2)
  strategy               String    @default("")
  decisions              String    @default("")
  filledBy               String
  evaluation             String?
  evaluatedAt            DateTime?
  updatedAt              DateTime  @updatedAt
  version                Int       @default(1)

  @@unique([outletKey, month])
}

model MarketInsight {
  id               String              @id @default(uuid()) @db.Uuid
  fingerprint      String
  activeFingerprint String?
  type             MarketInsightType
  title            String
  summary          String
  evidence         Json
  sourceReferences Json
  priority         Int
  confidence       Int
  status           MarketInsightStatus @default(active)
  version          Int                 @default(1)
  generatedAt      DateTime            @default(now())
  createdAt        DateTime            @default(now())

  @@index([type, generatedAt])
  @@index([status, generatedAt])
  @@index([fingerprint, status])
}

model ScrapeRun {
  id                String          @id @default(uuid()) @db.Uuid
  sourceId          String          @db.Uuid
  job               ScrapeJob
  status            ScrapeRunStatus @default(running)
  startedAt         DateTime        @default(now())
  finishedAt        DateTime?
  recordsDiscovered Int             @default(0)
  recordsSaved      Int             @default(0)
  duplicates        Int             @default(0)
  errors            Int             @default(0)
  createdAt         DateTime        @default(now())
  source            Source          @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  scrapeErrors      ScrapeError[]

  @@index([sourceId, createdAt])
  @@index([status, createdAt])
}

model ScrapeError {
  id         String      @id @default(uuid()) @db.Uuid
  runId      String      @db.Uuid
  sourceId   String      @db.Uuid
  url        String?
  stage      ScrapeStage
  message    String
  statusCode Int?
  createdAt  DateTime    @default(now())
  run        ScrapeRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  source     Source      @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([runId, createdAt])
  @@index([sourceId, createdAt])
}

model ScrapeLock {
  job        ScrapeJob @id
  acquiredAt DateTime  @default(now())
  ownerToken String
}
